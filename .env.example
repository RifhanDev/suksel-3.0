APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=v9
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local

# Attachment file server (172.16.2.147). Leave ATTACHMENT_REMOTE_ENABLED=false
# so uploads stay in the project folder. Flip to true only when ready to go live
# on production (APP_ENV=production). Local/staging always ignore remote storage.
#
# NAS paths on 172.16.2.147:
#   ATTACHMENT_ROOT        = new writes (3.0) → /data/laravel/perolehan_attachment
#   ATTACHMENT_LEGACY_ROOT = read fallback for 2.0 / old data → /data/laravel/uploads
ATTACHMENT_REMOTE_ENABLED=false
ATTACHMENT_DRIVER=ftp
ATTACHMENT_HOST=172.16.2.147
ATTACHMENT_PORT=21
ATTACHMENT_USERNAME=
ATTACHMENT_PASSWORD=
ATTACHMENT_ROOT=/data/laravel/perolehan_attachment
ATTACHMENT_LEGACY_ROOT=/data/laravel/uploads
ATTACHMENT_PASSIVE=true
ATTACHMENT_SSL=false

QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FPX_JOBS_LIMIT=1000
# PayNet response-signature verification. Roll out in two steps:
#   1. Deploy with false — verification runs and logs to storage/logs/fpx-respond.log
#      and fpx-listen.log, but does not block payments. Make a real test payment and
#      confirm the log shows it passing.
#   2. Then set true to actually reject callbacks that fail verification.
FPX_VERIFY_SIGNATURE=false
# TLS verification on outbound calls to PayNet. Leave true unless behind a
# TLS-intercepting corporate proxy.
FPX_VERIFY_TLS=true

# Client requirement: only FPX is used. eBPG code stays in place but is switched
# off everywhere via this flag. Set to true to bring it back.
EBPG_ENABLED=false
MAIL_SERVER="https://localhost.me/halalalutuju/mail_server/test/send_mail"
MAIL_SAMPLER="https://localhost.me/halalalutuju/mail_server/test/sampler"

# Scheduled tasks (config/schedule.php). Nothing runs without a cron entry:
#   * * * * * cd /path/to/app && php artisan schedule:run >> /dev/null 2>&1
# Verify what will actually run with: php artisan schedule:list
SCHEDULE_MAIL_RETRY=true
MAIL_RETRY_MIN_AGE_MINUTES=5
MAIL_RETRY_WINDOW_HOURS=72
MAIL_RETRY_BATCH_SIZE=20
# Defaults to true only when APP_ENV=production.
#SCHEDULE_FPX_REQUERY=true
# These email real users; keep false on staging/dev with cloned production data.
SCHEDULE_ELIGIBLE_EMAIL=false
SCHEDULE_ACCOUNT_REVIEW_REQUEST=false
SCHEDULE_PERIODIC_PASSWORD_RESET=false

# STOS Backend API Configuration (outbound: suksel -> STOS)
STOS_BACKEND_URL=https://stos-epenilaian-web.test
# Must match SERVICE_API_KEY in STOS-EPENILAIAN-WEB/.env (legacy API_KEY also accepted there)
STOS_BACKEND_API_KEY=253458d07403977241bc7d05fde258d533162e7459733d27fc2f61a36de68da0
# Set false for local .test domains with self-signed TLS (defaults false when APP_ENV != production)
STOS_BACKEND_VERIFY_SSL=false

# Inbound: STOS -> suksel webhook (defaults to STOS_BACKEND_API_KEY if unset)
STOS_INBOUND_API_KEY=